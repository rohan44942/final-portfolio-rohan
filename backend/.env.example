PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<dbName>?retryWrites=true&w=majority
JWT_SECRET=replace_with_secure_value
JWT_EXPIRY=1d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeMe123!
FRONTEND_URLS=http://localhost:5173,http://localhost:4173

# Optional - if empty, resume is stored in MongoDB binary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
