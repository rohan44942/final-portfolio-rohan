# Local Vite proxies /api and /health to the backend (port 5000).
# Leave this unset unless the API is on another origin:
# VITE_API_BASE_URL=http://localhost:5000/api

# Production on Vercel uses same-origin /api by default.
# Override only if the API is hosted elsewhere (must include /api):
# VITE_API_BASE_URL=https://final-portfolio-rohan.onrender.com/api
